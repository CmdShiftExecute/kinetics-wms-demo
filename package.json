{
  "name": "warehouse-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Warehouse management system dashboard: stock value and utilisation, ageing and ABC classes, replenishment cover, storage cost, an in-browser CBM calculator and inbound commitments. Static React and TypeScript, seeded synthetic data, 2,493 reconciliation checks. Live demo included.",
  "homepage": "https://warehouse-management-system-dashboard.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/CmdShiftExecute/warehouse-management-system.git"
  },
  "license": "MIT",
  "keywords": ["warehouse-management-system", "wms", "inventory-management", "warehouse", "stock-control", "replenishment", "abc-analysis", "supply-chain", "logistics", "cbm-calculator", "react", "typescript", "vite", "tailwindcss", "d3", "data-visualization", "synthetic-data", "demo", "bun"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "verticals": "bun scripts/import_verticals.ts",
    "data": "bun scripts/generate_demo_data.ts",
    "reconcile": "bun scripts/reconcile.ts",
    "stable": "bun scripts/check_stable.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "contrast": "bun scripts/check_contrast.ts",
    "check": "bun run data && bun run reconcile && bun run stable && bun run typecheck && bun run lint && bun run motion && bun run build && bun run contrast",
    "interactions": "bun scripts/interactions.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "scan": "bash scripts/scan_staged.sh",
    "motion": "bun scripts/check_motion.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
